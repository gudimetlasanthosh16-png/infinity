# ==============================================================================
#   INFINITY // J.A.R.V.I.S. MARK VII CONFIGURATION ENVIRONMENT
# ==============================================================================

# OpenRouter API Key for Multi-Modal LLM Reasoning
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telemetry & PUI Server Port
JARVIS_PORT=7777
JARVIS_HOST=127.0.0.1

# Default Large Language Model
# Examples: google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet, openai/gpt-4o
JARVIS_MODEL=google/gemini-2.0-flash-001

# Hotword & Voice Synthesis Configuration
WAKE_WORD=jarvis
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+15%

# Computer Vision & Hand Telemetry
CAMERA_INDEX=0
ENABLE_GESTURES=true
GESTURE_CONFIDENCE=0.75
